# Real environment values for local development.
# (In a real project, do NOT commit this file — add it to .gitignore.)

PORT=5000

# MongoDB Atlas connection string (database name: devblog)
MONGO_URI=mongodb+srv://rakib:rakib@cluster0.drqortc.mongodb.net/devblog?appName=Cluster0

# Secret used to sign login tokens (change to your own long random text)
JWT_SECRET=super_secret_change_me_to_something_long_and_random

# The frontend URL allowed to call this API (must be exact for cookies to work)
CLIENT_URL=http://localhost:3000

# Use "development" locally; set to "production" when deployed over HTTPS
NODE_ENV=development
