# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to Git.

# Port the server runs on
PORT=5000

# Your MongoDB connection string.
# Local MongoDB:   mongodb://127.0.0.1:27017/devblog
# MongoDB Atlas:   mongodb+srv://USER:PASS@cluster.mongodb.net/devblog
MONGO_URI=mongodb://127.0.0.1:27017/devblog

# A long random secret used to sign login tokens (make up your own)
JWT_SECRET=change_this_to_a_long_random_string

# Which frontend URL is allowed to call this API (your Next.js app)
# Must be the EXACT URL (not "*") so the auth cookie is allowed.
CLIENT_URL=http://localhost:3000

# Set to "production" when deployed (makes the cookie HTTPS-only).
# Leave unset/blank during local development.
NODE_ENV=development
